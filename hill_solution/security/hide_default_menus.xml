<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Employees menu visible only to Hill Managers -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('hill_solution.hill_case_manager')])]"/>
    </record>

    <!-- Website menu visible only to Hill Managers -->
    <record id="website.menu_website_configuration" model="ir.ui.menu">
        <field name="groups_id"
            eval="[(6, 0, [ref('hill_solution.hill_case_manager')])]"/>
    </record>

    <!-- Apps menu visible only to Hill Managers -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id"
            eval="[(6, 0, [ref('hill_solution.hill_case_manager')])]"/>
    </record>

</odoo>
