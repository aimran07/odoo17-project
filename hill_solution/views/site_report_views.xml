<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════
         TECHNICIAN VIEWS (existing — unchanged)
    ══════════════════════════════════════════════════════════ -->

    <!-- Tree View -->
    <record id="view_site_report_tree" model="ir.ui.view">
        <field name="name">site.report.tree</field>
        <field name="model">site.report</field>
        <field name="arch" type="xml">
            <tree string="Site Visits" create="false">
                <field name="case_number"/>
                <field name="name"/>
                <field name="technician_name"/>
                <field name="client_type" widget="badge"/>
                <field name="visit_date"/>
                <field name="stage_id" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_site_report_form" model="ir.ui.view">
        <field name="name">site.report.form</field>
        <field name="model">site.report</field>
        <field name="arch" type="xml">
            <form string="Site Visit" create="false">
                <header>
                    <field name="stage_id" widget="statusbar"/>

                    <field name="is_to_visit" invisible="1"/>
                    <field name="is_requested" invisible="1"/>
                    <field name="is_rejected" invisible="1"/>
                    <field name="is_report_saved" invisible="1"/>

                    <button name="action_generate_site_report"
                            string="Generate Visit Report"
                            type="object"
                            class="oe_highlight"
                            invisible="not is_to_visit or is_report_saved"/>
                    <button name="action_propagate_site_fields"
                            string="Request for Approval"
                            type="object"
                            class="oe_highlight"
                            invisible="not is_to_visit"/>
                    <button name="action_revert_rejection"
                            string="Revert"
                            type="object"
                            class="btn-warning"
                            invisible="not is_rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="case_number" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>
                    <group string="Visit Assignment">
                        <group>
                            <field name="case_id" readonly="1"/>
                            <field name="technician_name"/>
                            <field name="visit_date"/>
                            <field name="visit_duration"/>
                        </group>
                        <group>
                            <field name="client_type" readonly="1"/>
                            <field name="service_type"/>
                            <field name="is_visit_required"/>
                        </group>
                    </group>

                    <group string="B2B Information" invisible="client_type != 'b2b'">
                        <group>
                            <field name="company_name"/>
                            <field name="contact_firstname"/>
                            <field name="contact_lastname"/>
                            <field name="b2b_phone"/>
                        </group>
                        <group>
                            <field name="siret"/>
                            <field name="site_address"/>
                        </group>
                    </group>

                    <group string="B2C Information" invisible="client_type != 'b2c'">
                        <group>
                            <field name="beneficiary_firstname"/>
                            <field name="beneficiary_lastname"/>
                            <field name="beneficiary_phone"/>
                            <field name="beneficiary_status"/>
                        </group>
                        <group>
                            <field name="residential_address"/>
                        </group>
                    </group>

                    <group string="Site Data">
                        <group>
                            <field name="length" required="1"/>
                            <field name="breadth" required="1"/>
                            <field name="height" required="1"/>
                            <field name="area" required="1"/>
                        </group>
                        <group>
                            <field name="volume" required="1"/>
                            <field name="temperature" required="1"/>
                            <field name="pressure" required="1"/>
                        </group>
                    </group>

                    <group string="Visit Notes">
                        <field name="visit_notes"/>
                    </group>

                    <notebook>
                        <page string="Associated Documents">
                            <field name="document_ids" widget="hill_document_widget"/>
                        </page>
                        <page string="Associated Photos">
                            <field name="photo_ids" widget="hill_photo_widget"/>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_site_report_kanban" model="ir.ui.view">
        <field name="name">site.report.kanban</field>
        <field name="model">site.report</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="stage_id"
                    quick_create="false"
                    create="false">

                <field name="stage_id"/>
                <field name="stage_code"/>
                <field name="case_number"/>
                <field name="name"/>
                <field name="technician_name"/>
                <field name="technician_avatar"/>
                <field name="client_type"/>
                <field name="visit_date"/>
                <field name="site_address"/>
                <field name="residential_address"/>
                <field name="company_name"/>
                <field name="beneficiary_firstname"/>
                <field name="beneficiary_lastname"/>
                <field name="contact_firstname"/>
                <field name="contact_lastname"/>

                <field name="stage_name"/>
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-att-class="'hc_kanban_card oe_kanban_global_click ' +
                            (record.stage_code.raw_value == 'to_visit' ? 'sr_stage_tovisit' :
                            record.stage_code.raw_value == 'requested_for_approval' ? 'sr_stage_requested' :
                            record.stage_code.raw_value == 'approved' ? 'sr_stage_approved' :
                            record.stage_code.raw_value == 'rejected' ? 'sr_stage_rejected' : '')">

                            <div class="hc_card_accent"/>

                            <div class="hc_card_body">
                                <div class="hc_card_header">
                                    <span class="hc_case_number">
                                        <t t-esc="record.case_number.value"/>
                                    </span>
                                    <div class="hc_card_header_right">
                                        <span t-if="record.client_type.raw_value == 'b2b'"
                                                class="hc_badge hc_badge_b2b">B2B</span>
                                        <span t-if="record.client_type.raw_value == 'b2c'"
                                                class="hc_badge hc_badge_b2c">B2C</span>
                                    </div>
                                </div>

                                <div class="hc_card_title">
                                    <t t-esc="record.name.value or 'Untitled Visit'"/>
                                </div>

                                <div class="hc_card_client">
                                    <i class="fa fa-user me-1"/>
                                    <t t-if="record.client_type.raw_value == 'b2b'">
                                        <t t-esc="record.company_name.value or '-'"/>
                                    </t>
                                    <t t-if="record.client_type.raw_value == 'b2c'">
                                        <t t-esc="(record.beneficiary_firstname.value or '') + ' ' + (record.beneficiary_lastname.value or '')"/>
                                    </t>
                                </div>

                                <div class="hc_card_divider"/>

                                <div class="hc_card_footer">
                                    <div class="hc_card_agent">
                                        <t t-if="record.technician_avatar.raw_value">
                                            <img t-attf-src="/web/image/site.report/{{ record.id.raw_value }}/technician_avatar/24x24"
                                                 class="hc_agent_avatar"
                                                 t-att-alt="record.technician_name.value"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-user-circle hc_agent_avatar_icon"/>
                                        </t>
                                        <span class="hc_agent_name">
                                            <t t-esc="record.technician_name.value or 'Unassigned'"/>
                                        </span>
                                    </div>
                                    <div t-if="record.visit_date.raw_value">
                                        <span class="hc_visit_badge">
                                            <i class="fa fa-calendar me-1"/>
                                            <t t-esc="record.visit_date.value"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Technician Calendar View -->
    <record id="view_hill_case_calendar" model="ir.ui.view">
        <field name="name">site.report.calendar</field>
        <field name="model">site.report</field>
        <field name="arch" type="xml">
            <calendar string="My Visits"
                      date_start="visit_date"
                      color="technician_name"
                      mode="month">
                <field name="name"/>
                <field name="technician_name"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <!-- Technician visits action -->
    <record id="action_site_report" model="ir.actions.act_window">
        <field name="name">Technician Visits</field>
        <field name="res_model">site.report</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No site visits yet
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         MANAGER VIEWS — Technician Availability
    ══════════════════════════════════════════════════════════ -->

    <!-- Master Calendar — all technicians, colored by technician -->
    <record id="view_site_report_master_calendar" model="ir.ui.view">
        <field name="name">site.report.master.calendar</field>
        <field name="model">site.report</field>
        <field name="arch" type="xml">
            <calendar string="Master Calendar"
                      date_start="visit_date"
                      color="technician_name"
                      mode="month">
                <field name="name"/>
                <field name="technician_name"/>
                <field name="case_id"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <!-- Workload Summary List -->
    <record id="view_site_report_workload_list" model="ir.ui.view">
        <field name="name">site.report.workload.list</field>
        <field name="model">site.report</field>
        <field name="arch" type="xml">
            <tree string="Workload Summary"
                  create="false"
                  decoration-success="stage_id.name == 'Approved'"
                  decoration-warning="stage_id.name == 'Requested For Approval'"
                  decoration-danger="stage_id.name == 'Rejected'">
                <field name="technician_name" optional="show"/>
                <field name="name" string="Visit"/>
                <field name="case_id" string="Case"/>
                <field name="case_number" string="Case No."/>
                <field name="visit_date" string="Visit Date"/>
                <field name="client_type" string="Type" widget="badge"
                       decoration-primary="client_type == 'b2b'"
                       decoration-success="client_type == 'b2c'"/>
                <field name="stage_id" string="Status" widget="badge"
                       decoration-muted="stage_id.name == 'To Visit'"
                       decoration-info="stage_id.name == 'Visited'"
                       decoration-warning="stage_id.name == 'Requested For Approval'"
                       decoration-success="stage_id.name == 'Approved'"
                       decoration-danger="stage_id.name == 'Rejected'"/>
            </tree>
        </field>
    </record>

    <!-- Workload Search View -->
    <record id="view_site_report_workload_search" model="ir.ui.view">
        <field name="name">site.report.workload.search</field>
        <field name="model">site.report</field>
        <field name="arch" type="xml">
            <search string="Workload Summary">
                <field name="technician_name"/>
                <field name="case_id"/>
                <field name="stage_id"/>
                <separator/>
                <filter name="filter_to_visit"
                        string="Pending"
                        domain="[('stage_id.name','=','To Visit')]"/>
                <filter name="filter_approved"
                        string="Approved"
                        domain="[('stage_id.name','=','Approved')]"/>
                <filter name="filter_has_date"
                        string="Has Visit Date"
                        domain="[('visit_date','!=',False)]"/>
                <filter name="filter_no_date"
                        string="No Visit Date"
                        domain="[('visit_date','=',False)]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter name="group_technician"
                            string="Technician"
                            context="{'group_by':'technician_name'}"/>
                    <filter name="group_stage"
                            string="Status"
                            context="{'group_by':'stage_id'}"/>
                    <filter name="group_visit_date"
                            string="Visit Date"
                            context="{'group_by':'visit_date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Master Calendar Action -->
    <record id="action_site_report_master_calendar" model="ir.actions.act_window">
        <field name="name">Master Calendar</field>
        <field name="res_model">site.report</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_id" ref="view_site_report_master_calendar"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visits scheduled yet
            </p>
            <p>
                Visits appear here once technicians are assigned
                and visit dates are set.
            </p>
        </field>
    </record>

    <!-- Workload Summary Action -->
    <record id="action_site_report_workload" model="ir.actions.act_window">
        <field name="name">Workload Summary</field>
        <field name="res_model">site.report</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_site_report_workload_list"/>
        <field name="search_view_id" ref="view_site_report_workload_search"/>
        <field name="context">{'search_default_group_technician': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visits found
            </p>
        </field>
    </record>

</odoo>
