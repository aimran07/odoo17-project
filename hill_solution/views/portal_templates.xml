<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         PORTAL HOME — add Cases entry
    ══════════════════════════════════════════════════════════ -->
    <template id="portal_my_home_hill_case" name="Portal My Home: Hill Cases" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="config_card" t-value="True"/>
                <t t-set="title">My Cases</t>
                <t t-set="url" t-value="'/my/cases'"/>
                <t t-set="count" t-value="case_count"/>
                <t t-set="placeholder_count">case_count</t>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="config_card" t-value="True"/>
                <t t-set="title">My Invoices</t>
                <t t-set="url" t-value="'/my/invoices'"/>
                <t t-set="count" t-value="invoice_count"/>
                <t t-set="placeholder_count">invoice_count</t>
            </t>
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════
         PROFILE PAGE — extend portal_my_details
         One-time B2B/B2B selector + conditional fields
    ══════════════════════════════════════════════════════════ -->
    <template id="portal_my_details_fields_hill" inherit_id="portal.portal_my_details_fields">

        <!-- Remove Email field -->
        <xpath expr="//input[@name='email']/parent::div" position="replace"/>

        <!-- Remove Street field -->
        <xpath expr="//input[@name='street']/parent::div" position="replace"/>

        <!-- Replace Name field with client-type selector OR conditional fields -->
        <xpath expr="//input[@name='name']/parent::div" position="replace">

            <t t-if="not partner.hill_client_type">
                <div class="col-12 mb-3">
                    <label class="col-form-label">I am a</label>
                    <div class="d-flex gap-3">
                        <button type="button" onclick="selectClientType('b2b', this)" class="btn btn-secondary">Business (B2B)</button>
                        <button type="button" onclick="selectClientType('b2c', this)" class="btn btn-secondary">Individual (B2C)</button>
                    </div>
                    <t t-if="error.get('hill_client_type')">
                        <div class="text-danger small mt-1">Please select a client type.</div>
                    </t>
                </div>
                <div class="col-12 mb-3">
                    <input type="hidden" name="hill_client_type" id="hill_client_type_input"/>
                </div>
            </t>

            <t t-if="partner.hill_client_type">
                <input type="hidden" name="hill_client_type" t-att-value="partner.hill_client_type"/>

                <div class="col-12 mb-2">
                    <span class="text-muted">
                        <t t-if="partner.hill_client_type == 'b2b'">Business Details</t>
                        <t t-else="">Beneficiary Details</t>
                    </span>
                </div>

                <t t-if="partner.hill_client_type == 'b2b'">
                    <div t-attf-class="mb-3 #{error.get('hill_contact_firstname') and 'o_has_error' or ''} col-xl-6">
                        <label class="col-form-label" for="hill_contact_firstname">Contact First Name</label>
                        <input type="text" name="hill_contact_firstname" t-attf-class="form-control #{error.get('hill_contact_firstname') and 'is-invalid' or ''}" t-att-value="hill_contact_firstname or partner.hill_contact_firstname"/>
                    </div>
                    <div t-attf-class="mb-3 #{error.get('hill_contact_lastname') and 'o_has_error' or ''} col-xl-6">
                        <label class="col-form-label" for="hill_contact_lastname">Contact Last Name</label>
                        <input type="text" name="hill_contact_lastname" t-attf-class="form-control #{error.get('hill_contact_lastname') and 'is-invalid' or ''}" t-att-value="hill_contact_lastname or partner.hill_contact_lastname"/>
                    </div>
                </t>
                <t t-if="partner.hill_client_type == 'b2c'">
                    <div t-attf-class="mb-3 #{error.get('hill_beneficiary_firstname') and 'o_has_error' or ''} col-xl-6">
                        <label class="col-form-label" for="hill_beneficiary_firstname">Beneficiary First Name</label>
                        <input type="text" name="hill_beneficiary_firstname" t-attf-class="form-control #{error.get('hill_beneficiary_firstname') and 'is-invalid' or ''}" t-att-value="hill_beneficiary_firstname or partner.hill_beneficiary_firstname"/>
                    </div>
                    <div t-attf-class="mb-3 #{error.get('hill_beneficiary_lastname') and 'o_has_error' or ''} col-xl-6">
                        <label class="col-form-label" for="hill_beneficiary_lastname">Beneficiary Last Name</label>
                        <input type="text" name="hill_beneficiary_lastname" t-attf-class="form-control #{error.get('hill_beneficiary_lastname') and 'is-invalid' or ''}" t-att-value="hill_beneficiary_lastname or partner.hill_beneficiary_lastname"/>
                    </div>
                </t>
            </t>
        </xpath>

        <!-- Replace Phone field with conditional phone inputs -->
        <xpath expr="//input[@name='phone']/parent::div" position="replace">

            <div t-if="partner.hill_client_type == 'b2b'" t-attf-class="mb-3 #{error.get('hill_b2b_phone') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="hill_b2b_phone">Phone</label>
                <input type="tel" name="hill_b2b_phone" t-attf-class="form-control #{error.get('hill_b2b_phone') and 'is-invalid' or ''}" t-att-value="hill_b2b_phone or partner.hill_b2b_phone"/>
            </div>
            <div t-if="partner.hill_client_type == 'b2c'" t-attf-class="mb-3 #{error.get('hill_beneficiary_phone') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="hill_beneficiary_phone">Phone</label>
                <input type="tel" name="hill_beneficiary_phone" t-attf-class="form-control #{error.get('hill_beneficiary_phone') and 'is-invalid' or ''}" t-att-value="hill_beneficiary_phone or partner.hill_beneficiary_phone"/>
            </div>
        </xpath>

        <!-- Replace Company Name field with conditional company / beneficiary-status / siret / residential address -->
        <xpath expr="//input[@name='company_name']/parent::div" position="replace">

            <t t-if="partner.hill_client_type == 'b2b'">
                <div t-attf-class="mb-1 #{error.get('hill_company_name') and 'o_has_error' or ''} col-xl-6">
                    <label class="col-form-label label-optional" for="hill_company_name">Company Name</label>
                    <input type="text" name="hill_company_name" t-attf-class="form-control #{error.get('hill_company_name') and 'is-invalid' or ''}" t-att-value="hill_company_name or partner.hill_company_name"/>
                </div>
                <div t-attf-class="mb-1 #{error.get('hill_siret') and 'o_has_error' or ''} col-xl-6">
                    <label class="col-form-label label-optional" for="hill_siret">SIRET Number</label>
                    <input type="text" name="hill_siret" t-attf-class="form-control #{error.get('hill_siret') and 'is-invalid' or ''}" t-att-value="hill_siret or partner.hill_siret"/>
                </div>
            </t>
            <t t-if="partner.hill_client_type == 'b2c'">
                <div t-attf-class="mb-3 #{error.get('hill_beneficiary_status') and 'o_has_error' or ''} col-xl-6">
                    <label class="col-form-label" for="hill_beneficiary_status">Beneficiary Status</label>
                    <select name="hill_beneficiary_status" class="form-select">
                        <option value="standard" t-att-selected="(hill_beneficiary_status or partner.hill_beneficiary_status or 'standard') == 'standard' or None">Standard</option>
                        <option value="vulnerable" t-att-selected="(hill_beneficiary_status or partner.hill_beneficiary_status or 'standard') == 'vulnerable' or None">Vulnerable (Hardship)</option>
                        <option value="high_vulnerability" t-att-selected="(hill_beneficiary_status or partner.hill_beneficiary_status or 'standard') == 'high_vulnerability' or None">High-Vulnerability (Extreme Hardship)</option>
                    </select>
                </div>
            </t>
        </xpath>

    </template>

    <template id="portal_hill_client_type_script" inherit_id="portal.portal_my_details_fields">
        <xpath expr="//select[@name='state_id']" position="after">
            <script type="text/javascript">
                function selectClientType(type, btn) {
                    document.getElementById('hill_client_type_input').value = type;
                    btn.form.submit();
                }
            </script>
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════
        CASE LIST PAGE
    ══════════════════════════════════════════════════════════ -->
    <template id="portal_my_cases" name="My Cases">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Cases</t>
            </t>

            <t t-if="not cases">
                <div class="alert alert-info mt-3">
                    You have no cases yet.
                    <a href="/my/cases/new" class="alert-link">Submit your first case.</a>
                </div>
            </t>

            <t t-if="cases">
                <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">My Cases</h5>
                        <a href="/my/cases/new" class="btn btn-primary btn-sm">
                            <i class="fa fa-plus me-1"/>
                            New Case
                        </a>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Case Number</th>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Stage</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="cases" t-as="case">
                                    <tr style="cursor:pointer;" t-attf-onclick="window.location='/my/cases/#{case.id}'">
                                        <td>
                                            <t t-esc="case.case_number"/>
                                        </td>
                                        <td>
                                            <t t-esc="case.name or 'Pending'"/>
                                        </td>
                                        <td>
                                            <span t-if="case.client_type == 'b2b'" class="badge bg-primary">B2B</span>
                                            <span t-if="case.client_type == 'b2c'" class="badge bg-success">B2C</span>
                                        </td>
                                        <td>
                                            <t t-esc="case.stage_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="case.create_date" t-options='{"widget": "date"}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>

            <!-- <div class="mt-3 text-end">
                <a href="/my/cases/new" class="btn btn-primary">
                    <i class="fa fa-plus me-1"/>Submit New Case
                </a>
            </div> -->

        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════
         NEW CASE FORM PAGE
    ══════════════════════════════════════════════════════════ -->
    <template id="portal_case_form" name="Submit New Case">
        <t t-call="portal.portal_layout">
            <div class="row mt-3">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="mb-0">
                                <i class="fa fa-folder-open me-2"/>
                                Submit New Case
                            </h4>
                        </div>
                        <div class="card-body">
                            <form action="/my/cases/submit" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="client_type" t-att-value="client_type"/>

                                <div class="mb-2">
                                    <span class="text-muted">
                                        <t t-if="client_type == 'b2b'">Business Details</t>
                                        <t t-else="">Beneficiary Details</t>
                                    </span>
                                </div>

                                <t t-if="client_type == 'b2b'">
                                    <div t-attf-class="mb-3 #{error.get('company_name') and 'o_has_error' or ''} col-xl-6">
                                        <label class="col-form-label label-optional" for="company_name">Company Name</label>
                                        <input type="text" class="form-control" t-att-value="partner.hill_company_name or ''" readonly="readonly"/>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="col-form-label" for="contact_firstname">Contact First Name</label>
                                            <input type="text" name="contact_firstname" class="form-control" t-att-value="partner.hill_contact_firstname or ''"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="col-form-label" for="contact_lastname">Contact Last Name</label>
                                            <input type="text" name="contact_lastname" class="form-control" t-att-value="partner.hill_contact_lastname or ''"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="col-form-label" for="b2b_phone">Phone</label>
                                            <input type="tel" name="b2b_phone" class="form-control" t-att-value="partner.hill_b2b_phone or ''"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="col-form-label">Service Type</label>
                                             <select name="service_type" class="form-select">
                                                 <option value="">-- Select --</option>
                                                 <option value="ndd" t-att-selected="post.get('service_type') == 'ndd' or None">
                                                     NDD
                                                 </option>
                                                 <option value="heat_destratifier" t-att-selected="post.get('service_type') == 'heat_destratifier' or None">
                                                     Heat destratifier
                                                 </option>
                                                 <option value="led_study" t-att-selected="post.get('service_type') == 'led_study' or None">
                                                     LED study
                                                 </option>
                                                 <option value="study_163" t-att-selected="post.get('service_type') == 'study_163' or None">
                                                     Study 163
                                                 </option>
                                                 <option value="regulatory_audit" t-att-selected="post.get('service_type') == 'regulatory_audit' or None">
                                                     Regulatory audit
                                                 </option>
                                             </select>
                                         </div>
                                     </div>
                                     <div class="row">
                                         <div class="col-md-6 mb-3">
                                             <label class="col-form-label label-optional" for="siret">SIRET Number</label>
                                            <input type="text" class="form-control" t-att-value="partner.hill_siret or ''" readonly="readonly"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="col-form-label" for="site_address">Site Address <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" name="site_address"
                                                   t-attf-class="form-control #{error.get('site_address') and 'is-invalid' or ''}"
                                                   t-att-value="post.get('site_address', '')"/>
                                        </div>
                                    </div>
                                    <!-- <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="col-form-label">Prestation Type <span class="text-danger">*</span></label>
                                            <select name="prestation_type" class="form-select">
                                                <option value="">Select</option>
                                                <option value="otg" t-att-selected="post.get('prestation_type') == 'otg' or None">
                                                    Obligation to Give
                                                </option>
                                                <option value="otd" t-att-selected="post.get('prestation_type') == 'otd' or None">
                                                    Obligation to Do
                                                </option>
                                                <option value="ontd" t-att-selected="post.get('prestation_type') == 'ontd' or None">
                                                    Obligation Not to Do
                                                </option>
                                            </select>
                                        </div>
                                    </div> -->
                                 </t>
                                 <!-- B2C New Case Form -->
                                 <t t-if="client_type == 'b2c'">
                                     <!-- First and Last Name -->
                                     <div class="row">
                                         <div class="col-md-6 mb-3">
                                             <label class="col-form-label" for="beneficiary_firstname">Beneficiary First Name</label>
                                             <input type="text" name="beneficiary_firstname" class="form-control" t-att-value="partner.hill_beneficiary_firstname or ''"/>
                                         </div>
                                         <div class="col-md-6 mb-3">
                                             <label class="col-form-label" for="beneficiary_lastname">Beneficiary Last Name</label>
                                             <input type="text" name="beneficiary_lastname" class="form-control" t-att-value="partner.hill_beneficiary_lastname or ''"/>
                                         </div>
                                     </div>
                                     <!-- Phone and Service Type -->
                                     <div class="row">
                                         <div class="col-md-6 mb-3">
                                             <label class="col-form-label" for="beneficiary_phone">Phone</label>
                                             <input type="tel" name="beneficiary_phone" class="form-control" t-att-value="partner.hill_beneficiary_phone or ''"/>
                                         </div>
                                         <div class="col-md-6 mb-3">
                                             <label class="col-form-label">Service Type</label>
                                             <select name="service_type" class="form-select">
                                                 <option value="">-- Select --</option>
                                                 <option value="sizing_171" t-att-selected="post.get('service_type') == 'sizing_171' or None">Sizing 171</option>
                                                 <option value="study_174" t-att-selected="post.get('service_type') == 'study_174' or None">Study 174</option>
                                                 <option value="study_175" t-att-selected="post.get('service_type') == 'study_175' or None">Study 175</option>
                                                 <option value="study_179" t-att-selected="post.get('service_type') == 'study_179' or None">Study 179</option>
                                             </select>
                                         </div>
                                     </div>
                                     <!-- Residential Address and Prestation Type -->
                                     <div class="row">
                                         <div class="col-md-6 mb-3">
                                             <label class="col-form-label" for="residential_address">Residential Address <span class="text-danger">*</span></label>
                                             <input type="text" name="residential_address" class="form-control" t-att-value="post.get('residential_address', '')"/>
                                         </div>
                                         <!-- <div class="col-md-6 mb-3">
                                             <label class="col-form-label">Prestation Type <span class="text-danger">*</span></label>
                                             <select name="prestation_type" class="form-select">
                                                 <option value=""> Select </option>
                                                 <option value="otg" t-att-selected="post.get('prestation_type') == 'otg' or None">Obligation to Give</option>
                                                 <option value="otd" t-att-selected="post.get('prestation_type') == 'otd' or None">Obligation to Do</option>
                                                 <option value="ontd" t-att-selected="post.get('prestation_type') == 'ontd' or None">Obligation Not to Do</option>
                                             </select>
                                         </div> -->
                                     </div>
                                 </t>
                                 <!-- Documents Section (Common for both B2B and B2C) -->
                                 <div class="row">
                                     <div class="col-md-6 mb-3">
                                         <label class="col-form-label">Documents <span class="text-muted">(Optional)</span></label>
                                         <input type="file" name="documents" class="form-control" multiple="multiple" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.txt"/>
                                         <small class="text-muted">You can select multiple files.</small>
                                     </div>
                                 </div>

                                 <div class="d-flex justify-content-between mt-4">
                                    <a href="/my/cases" class="btn btn-secondary">
                                        <i class="fa fa-arrow-left me-1"/>
                                        Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-paper-plane me-1"/>
                                        Submit Case
                                    </button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════
         CASE DETAIL PAGE
    ══════════════════════════════════════════════════════════ -->
    <template id="portal_case_detail" name="Case Detail">
        <t t-call="portal.portal_layout">
            <div class="row mt-3">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">
                                <i class="fa fa-folder-open me-2"/>
                                Case <t t-esc="case.case_number"/>
                            </h4>
                            <span class="badge bg-primary fs-6">
                                <t t-esc="case.stage_id.name"/>
                            </span>
                        </div>
                        <div class="card-body">

                            <t t-if="case.name">
                                <h5 class="mb-3">
                                    <t t-esc="case.name"/>
                                </h5>
                            </t>

                            <div class="mb-3">
                                <span t-if="case.client_type == 'b2b'" class="badge bg-primary me-2">B2B</span>
                                <span t-if="case.client_type == 'b2c'" class="badge bg-success me-2">B2C</span>
                                <small class="text-muted">
                                    Submitted on
                                    <t t-esc="case.create_date" t-options='{"widget": "date"}'/>
                                </small>
                            </div>

                            <hr/>

                            <!-- B2B details -->
                            <t t-if="case.client_type == 'b2b'">
                                <h6 class="text-muted mb-3">Business Information</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong>Company:</strong>
                                        <t t-esc="case.company_name or '-'"/>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Contact:</strong>
                                        <t t-esc="(case.contact_firstname or '') + ' ' + (case.contact_lastname or '')"/>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Phone:</strong>
                                        <t t-esc="case.b2b_phone or '-'"/>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>SIRET:</strong>
                                        <t t-esc="case.siret or '-'"/>
                                    </div>
                                    <div class="col-12 mb-2">
                                        <strong>Site Address:</strong>
                                        <t t-esc="case.site_address or '-'"/>
                                    </div>
                                </div>
                            </t>

                            <!-- B2C details -->
                            <t t-if="case.client_type == 'b2c'">
                                <h6 class="text-muted mb-3">Beneficiary Information</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <strong>Name:</strong>
                                        <t t-esc="(case.beneficiary_firstname or '') + ' ' + (case.beneficiary_lastname or '')"/>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Phone:</strong>
                                        <t t-esc="case.beneficiary_phone or '-'"/>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <strong>Status:</strong>
                                        <t t-esc="dict(case._fields['beneficiary_status'].selection).get(case.beneficiary_status, '-')"/>
                                    </div>
                                    <div class="col-12 mb-2">
                                        <strong>Address:</strong>
                                        <t t-esc="case.residential_address or '-'"/>
                                    </div>
                                </div>
                            </t>

                            <hr/>

                            <!-- Service details -->
                            <h6 class="text-muted mb-3">Service Details</h6>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <strong>Prestation Type:</strong>
                                    <t t-esc="dict(case._fields['prestation_type'].selection).get(case.prestation_type, '-')"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Service Type:</strong>
                                    <t t-esc="dict(case._fields['service_type'].selection).get(case.service_type, '-')"/>
                                </div>
                            </div>

<hr/>

                             <!-- Documents -->
                             <t t-if="case.document_ids">
                                 <h6 class="text-muted mb-3">Documents</h6>
                                 <div class="table-responsive">
                                     <table class="table table-sm table-hover mb-0">
                                         <thead class="table-light">
                                             <tr>
                                                 <th>Name</th>
                                                 <th>Type</th>
                                                 <th>Size</th>
                                             </tr>
                                         </thead>
                                         <tbody>
                                             <t t-foreach="case.document_ids" t-as="document">
                                                 <tr t-if="document.attachment_id">
                                                     <td>
                                                         <a t-att-href="'/web/content/' + str(document.attachment_id.id) + '?download=false'" t-esc="document.name"/>
                                                     </td>
                                                     <td><t t-esc="document.mimetype"/></td>
                                                     <td><t t-esc="document.file_size"/> bytes</td>
                                                 </tr>
                                             </t>
                                         </tbody>
                                     </table>
                                 </div>
                                 <hr/>
                             </t>

                             <!-- Case progress -->
                            <h6 class="text-muted mb-3">Case Progress</h6>
                            <div class="row text-center">
                                <div class="col mb-2">
                                    <div t-att-class="'p-2 rounded ' + ('bg-success text-white' if case.stage_id.sequence >= 1 else 'bg-light text-muted')">
                                        <i class="fa fa-file-text d-block mb-1"/>
                                        <small>New Case</small>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    <div t-att-class="'p-2 rounded ' + ('bg-success text-white' if case.stage_id.sequence >= 2 else 'bg-light text-muted')">
                                        <i class="fa fa-calendar d-block mb-1"/>
                                        <small>Appointment</small>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    <div t-att-class="'p-2 rounded ' + ('bg-success text-white' if case.stage_id.sequence >= 3 else 'bg-light text-muted')">
                                        <i class="fa fa-map-marker d-block mb-1"/>
                                        <small>Visit</small>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    <div t-att-class="'p-2 rounded ' + ('bg-success text-white' if case.stage_id.sequence >= 4 else 'bg-light text-muted')">
                                        <i class="fa fa-book d-block mb-1"/>
                                        <small>Study</small>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    <div t-att-class="'p-2 rounded ' + ('bg-success text-white' if case.stage_id.sequence >= 5 else 'bg-light text-muted')">
                                        <i class="fa fa-file-text d-block mb-1"/>
                                        <small>Invoice</small>
                                    </div>
                                </div>
                                <div class="col mb-2">
                                    <div t-att-class="'p-2 rounded ' + ('bg-success text-white' if case.stage_id.sequence >= 6 else 'bg-light text-muted')">
                                        <i class="fa fa-check-circle d-block mb-1"/>
                                        <small>Done</small>
                                    </div>
                                </div>
                            </div>

                            <t t-if="case.invoice_id">
                                <hr/>
                                <h6 class="text-muted mb-3">Invoice</h6>
                                <a t-att-href="'/my/invoices/%s/download' % case.invoice_id.id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fa fa-download me-1"/>
                                    Download Invoice <t t-esc="case.invoice_id.name"/>
                                </a>
                            </t>

                        </div>
                        <div class="card-footer">
                            <a href="/my/cases" class="btn btn-secondary btn-sm">
                                <i class="fa fa-arrow-left me-1"/>
Back to My Cases
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════
         INVOICE LIST PAGE
    ══════════════════════════════════════════════════════════ -->
    <template id="portal_my_invoices" name="My Invoices">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Invoices</t>
            </t>

            <t t-if="not invoices">
                <div class="alert alert-info mt-3">
                    You have no invoices yet.
                </div>
            </t>

            <t t-if="invoices">
                <div class="card mt-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">My Invoices</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Invoice No</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="invoices" t-as="invoice">
                                    <tr style="cursor:pointer;" t-attf-onclick="window.location='/my/invoices/#{invoice.id}'">
                                        <td>
                                            <t t-esc="invoice.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="invoice.invoice_date" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td>
                                            <t t-esc="invoice.amount_total" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                        </td>
                                        <td>
                                            <span t-if="invoice.state == 'paid'" class="badge bg-success">Paid</span>
                                            <span t-elif="invoice.state == 'generated'" class="badge bg-primary">Generated</span>
                                            <span t-else="" class="badge bg-secondary">Draft</span>
                                        </td>
                                        <td class="text-end">
                                            <a t-att-href="'/my/invoices/%s/download' % invoice.id"
                                               class="btn btn-sm btn-outline-primary"
                                               t-attf-onclick="event.stopPropagation();">
                                                <i class="fa fa-download me-1"/>
                                                Download
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </t>

        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════
         INVOICE DETAIL PAGE
    ══════════════════════════════════════════════════════════ -->
    <template id="portal_invoice_detail" name="Invoice Detail">
        <t t-call="portal.portal_layout">
            <div class="row mt-3">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">
                                <i class="fa fa-file-text me-2"/>
                                Invoice <t t-esc="invoice.name"/>
                            </h4>
                            <span t-if="invoice.state == 'paid'" class="badge bg-success fs-6">Paid</span>
                            <span t-elif="invoice.state == 'generated'" class="badge bg-primary fs-6">Generated</span>
                            <span t-else="" class="badge bg-secondary fs-6">Draft</span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <strong>Customer:</strong>
                                    <t t-esc="invoice.partner_id.name or '-'"/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Invoice Date:</strong>
                                    <t t-esc="invoice.invoice_date" t-options='{"widget": "date"}'/>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <strong>Amount Total:</strong>
                                    <t t-esc="invoice.amount_total" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                </div>
                            </div>

                            <hr/>

                            <h6 class="text-muted mb-3">Invoice Lines</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Case No</th>
                                            <th>Service</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="invoice.invoice_line_ids" t-as="line">
                                            <tr>
                                                <td><t t-esc="line.case_number or '-'"/></td>
                                                <td>
                                                    <t t-esc="dict(line._fields['service_type'].selection).get(line.service_type, '-')"/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-esc="line.amount" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colspan="2" class="text-end fw-bold">Total</td>
                                            <td class="text-end fw-bold">
                                                <t t-esc="invoice.amount_total" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                                <a t-att-href="'/my/invoices/%s/download' % invoice.id"
                                   class="btn btn-primary">
                                    <i class="fa fa-download me-1"/>
                                    Download PDF
                                </a>
                            </div>
                        </div>
                        <div class="card-footer">
                            <a href="/my/invoices" class="btn btn-secondary btn-sm">
                                <i class="fa fa-arrow-left me-1"/>
                                Back to My Invoices
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
