<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hill_service_type_tree" model="ir.ui.view">
        <field name="name">hill.service.type.list</field>
        <field name="model">hill.service.type</field>
        <field name="arch" type="xml">
            <tree string="Service Types">
                <field name="name" />
                <field name="code" />
                <field name="client_type" widget="badge" />
                <field name="sequence" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <record id="view_hill_service_type_form" model="ir.ui.view">
        <field name="name">hill.service.type.form</field>
        <field name="model">hill.service.type</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1" />
                            <field name="code" required="1" />
                            <field name="client_type" required="1" />
                        </group>
                        <group>
                            <field name="sequence" />
                            <field name="active" />
                            <field name="visit_required" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hill_service_type" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">hill.service.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
