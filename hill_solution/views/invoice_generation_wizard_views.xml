<odoo>
    <record id="view_invoice_generation_wizard_form" model="ir.ui.view">
        <field name="name">invoice.generation.wizard.form</field>
        <field name="model">invoice.generation.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Invoice">
                <sheet>
                    <group>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="selected"/>
                            <field name="case_number"/>
                            <field name="service_type"/>
                            <field name="amount"/>
                        </tree>
                    </field>
                    <group>
                        <field name="amount_total" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        string="Generate Invoice"
                        name="action_generate_invoice"
                        type="object"
                        class="btn-primary"/>
                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
