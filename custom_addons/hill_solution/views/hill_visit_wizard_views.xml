<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hill_visit_wizard_form" model="ir.ui.view">
        <field name="name">hill.visit.wizard.form</field>
        <field name="model">hill.visit.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Site Visit">
                <field name="case_id" invisible="1"/>

                <group>
                    <group>
                        <field name="client_type" readonly="1"/>
                        <field name="service_type" readonly="1"/>
                        <field name="case_number" readonly="1"/>
                    </group>
                    <group invisible="client_type != 'b2b'">
                        <field name="company_name" readonly="1"/>
                        <field name="contact_firstname" readonly="1"/>
                        <field name="contact_lastname" readonly="1"/>
                        <field name="b2b_phone" readonly="1"/>
                        <field name="siret" readonly="1"/>
                        <field name="site_address" readonly="1"/>
                    </group>
                    <group invisible="client_type != 'b2c'">
                        <field name="beneficiary_firstname" readonly="1"/>
                        <field name="beneficiary_lastname" readonly="1"/>
                        <field name="beneficiary_phone" readonly="1"/>
                        <field name="beneficiary_status" readonly="1"/>
                        <field name="residential_address" readonly="1"/>
                    </group>
                </group>

                <group string="Visit Details">
                    <group>
                        <field name="technician_name"/>
                    </group>
                    <group>
                        <field name="visit_date" widget="visit_date_widget" />
                    </group>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
