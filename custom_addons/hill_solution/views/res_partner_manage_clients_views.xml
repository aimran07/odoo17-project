<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hill_manage_clients_tree" model="ir.ui.view">
        <field name="name">hill.manage.clients.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Manage Clients">
                <field name="name" />
                <field name="email" />
                <field name="hill_client_type" widget="badge" />
                <field name="hill_requires_advance_payment" />
            </tree>
        </field>
    </record>

    <record id="view_hill_manage_clients_form" model="ir.ui.view">
        <field name="name">hill.manage.clients.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Manage Client">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group string="Profile Details">
                        <field name="email" readonly="1" />
                        <field name="hill_client_type" widget="badge" readonly="1" />
                        <field name="hill_company_name" invisible="hill_client_type != 'b2b'" readonly="1" />
                        <field name="hill_contact_firstname" invisible="hill_client_type != 'b2b'" readonly="1" />
                        <field name="hill_contact_lastname" invisible="hill_client_type != 'b2b'" readonly="1" />
                        <field name="hill_b2b_phone" invisible="hill_client_type != 'b2b'" readonly="1" />
                        <field name="hill_siret" invisible="hill_client_type != 'b2b'" readonly="1" />
                        <field name="hill_beneficiary_firstname" invisible="hill_client_type != 'b2c'" readonly="1" />
                        <field name="hill_beneficiary_lastname" invisible="hill_client_type != 'b2c'" readonly="1" />
                        <field name="hill_beneficiary_phone" invisible="hill_client_type != 'b2c'" readonly="1" />
                        <field name="hill_beneficiary_status" invisible="hill_client_type != 'b2c'" readonly="1" />
                        <field name="hill_requires_advance_payment" string="Requires Advance Payment" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hill_manage_clients" model="ir.actions.act_window">
        <field name="name">Manage Clients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('hill_client_type', '!=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('view_hill_manage_clients_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_hill_manage_clients_form')})]"/>
    </record>
</odoo>
