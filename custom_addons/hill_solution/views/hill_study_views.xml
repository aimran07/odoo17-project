<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hill_study_tree" model="ir.ui.view">
        <field name="name">hill.study.tree</field>
        <field name="model">hill.study</field>
        <field name="arch" type="xml">
            <tree string="Studies">
                <field name="case_number"/>
                <field name="name"/>
                <field name="client_type" widget="badge"/>
                <field name="study_status"/>
                <field name="visit_date"/>
                <field name="stage_id" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hill_study_form" model="ir.ui.view">
        <field name="name">hill.study.form</field>
        <field name="model">hill.study</field>
        <field name="arch" type="xml">
            <form string="Study">
                <header>
                    <field name="stage_id" widget="statusbar" />

                    <field name="is_to_process" invisible="1" />
                    <field name="is_in_progress" invisible="1" />
                    <!-- <field name="is_visit" invisible="1" />
                    <field name="is_new_case" invisible="1" /> -->
                    <!-- <field name="can_create_study" invisible="1" /> -->
                    <!-- <field name="is_appointment" invisible="1" />
                    <field name="is_validated" invisible="1" /> -->

                    <!-- <button name="action_validate_case" string="Validate" type="object" class="btn-warning" invisible="not is_new_case" />
                    <button name="action_approve_visit_details" string="Approve" type="object" class="btn-success" invisible="not is_visit or not has_pending_approval" />
                    <button name="action_reject_visit_details" string="Reject" type="object" class="btn-danger" invisible="not is_visit or not has_pending_approval" />
                    <button name="action_create_study" string="Create Study" type="object" class="oe_highlight" invisible="not can_create_study" /> -->

                    <button name="action_start_study" string="Start Study"
                            type="object" class="oe_highlight"
                            invisible="not is_to_process" />
                    <button name="action_study_complete" string="Study Complete"
                            type="object" class="oe_highlight"
                            invisible="not is_in_progress" />
                    

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="case_number" readonly="1" />
                        </h1>
                        <h2>
                            <field name="name" placeholder="Case Title" readonly="1" />
                        </h2>
                    </div>
                    <group>
                        <group string="Case Info">
                            <field name="client_type" readonly="1" />
                            <!-- <field name="service_type" /> -->
                            <!-- <field name="is_visit_required" invisible="1" /> -->
                            <!-- <field name="date_deadline" /> -->
                        </group>
                        <!-- <group string="Assignment">
                            <field name="agent_name" widget="many2one_avatar_user" />
                            <field name="technician_name" widget="many2one_avatar_user" />
                        </group> -->
                    </group>
                    <!-- <group string="Appointment">
                        <field name="appointment_status" />
                    </group> -->
                    <group string="B2B Information" invisible="client_type != 'b2b'">
                        <group>
                            <field name="company_name" />
                            <field name="contact_firstname" />
                            <field name="contact_lastname" />
                            <field name="b2b_phone" />
                        </group>
                        <group>
                            <field name="siret" />
                            <field name="site_address" />
                        </group>
                    </group>
                    <group string="B2C Information" invisible="client_type != 'b2c'">
                        <group>
                            <field name="beneficiary_firstname" />
                            <field name="beneficiary_lastname" />
                            <field name="beneficiary_phone" />
                            <field name="beneficiary_status" />
                        </group>
                        <group>
                            <field name="residential_address" />
                        </group>
                    </group>
                    <group string="Technical Visit">
                        <group>
                            <field name="visit_date" />
                            <field name="visit_duration" />
                        </group>
                    </group>
                    <group string="Study">
                        <group>
                            <field name="study_status" />
                            <field name="study_nature" />
                            <field name="study_data" placeholder="Enter study input data (for studies without visit)" />
                        </group>
                    </group>
                    <!-- <group string="Financial">
                        <group>
                            <field name="amount_total" />
                            <field name="payment_status" />
                        </group>
                        <group>
                            <field name="invoice_status" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group> -->

                    <notebook>
                        <page string="Site Details">
                            <group string="Site Data">
                                <group>
                                    <field name="length" />
                                    <field name="breadth" />
                                    <field name="height" />
                                    <field name="area" />
                                </group>
                                <group>
                                    <field name="volume" />
                                    <field name="temperature" />
                                    <field name="pressure" />
                                </group>
                            </group>
                            <group string="Visit Notes">
                                <field name="visit_notes" nolabel="1" readonly="1" />
                            </group>
                        </page>
                        <!-- <page string="Associated Documents" name="case_documents">
                            <field name="document_ids" widget="hill_document_widget" readonly="1" />
                        </page>
                        <page string="Associated Photos" name="case_photos">
                            <field name="photo_ids" widget="hill_photo_widget" readonly="1" />
                        </page> -->
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <!-- Kanban View -->
    <record id="view_hill_study_kanban" model="ir.ui.view">
        <field name="name">hill.study.kanban</field>
        <field name="model">hill.study</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="stage_id" quick_create="false">
                <field name="case_number"/>
                <field name="name"/>
                <field name="client_type"/>
                <field name="study_status"/>
                <field name="stage_id"/>
                <field name="company_name"/>
                <field name="beneficiary_firstname"/>
                <field name="beneficiary_lastname"/>
                <field name="visit_date"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-att-class="'hc_kanban_card oe_kanban_global_click ' +
                        (record.stage_id.value == 'To Process' ? 'hs_stage_to_process' :
                        record.stage_id.value == 'In Progress' ? 'hs_stage_in_progress' :
                        record.stage_id.value == 'Completed' ? 'hs_stage_completed' :
                        record.stage_id.value == 'To Modify' ? 'hs_stage_to_modify' :
                        record.stage_id.value == 'Validated' ? 'hs_stage_validated' : '')">

                            <div class="hc_card_accent"/>

                            <div class="hc_card_body">
                                <div class="hc_card_header">
                                    <span class="hc_case_number">
                                        <t t-esc="record.case_number.value"/>
                                    </span>
                                    <div class="hc_card_header_right">
                                        <span t-if="record.client_type.raw_value == 'b2b'" class="hc_badge hc_badge_b2b">B2B</span>
                                        <span t-if="record.client_type.raw_value == 'b2c'" class="hc_badge hc_badge_b2c">B2C</span>
                                    </div>
                                </div>

                                <div class="hc_card_title">
                                    <t t-esc="record.name.value or 'Untitled Study'"/>
                                </div>

                                <div class="hc_card_client">
                                    <i class="fa fa-user me-1"/>
                                    <t t-if="record.client_type.raw_value == 'b2b'">
                                        <t t-esc="record.company_name.value or '-'"/>
                                    </t>
                                    <t t-if="record.client_type.raw_value == 'b2c'">
                                        <t t-esc="(record.beneficiary_firstname.value or '') + ' ' + (record.beneficiary_lastname.value or '')"/>
                                    </t>
                                </div>

                                <div class="hc_card_divider"/>

                                <div class="hc_card_footer">
                                    <div class="hc_card_agent">
                                        <span class="hc_agent_name">
                                            <t t-esc="record.study_status.value or 'Pending'"/>
                                        </span>
                                    </div>
                                    <div t-if="record.visit_date.raw_value">
                                        <span class="hc_visit_badge">
                                            <i class="fa fa-calendar me-1"/>
                                            <t t-esc="record.visit_date.value"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hill_study" model="ir.actions.act_window">
        <field name="name">Studies</field>
        <field name="res_model">hill.study</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Study!
            </p>
        </field>
    </record>
</odoo>
